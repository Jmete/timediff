# Copy to .env.local for local dev, and add the same keys in Vercel → Settings → Environment Variables.

# Admin login (the admin password only lives here, never in the database). Min 12 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-something-long

# Turso database (hosted SQLite). Leave unset locally to use ./local.db.
# TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
# TURSO_AUTH_TOKEN=
